{
  "schemaVersion": 1,
  "project": {
    "name": "Posita",
    "package": "posita",
    "description": "Desktop-first personal mail hub organized around people, topics, context, and actions.",
    "repository": "https://github.com/morningstar-charmandor/posita",
    "repositoryVisibility": "public",
    "canonicalBranch": "main",
    "currentMilestone": "gate-2c-encrypted-private-data-cache",
    "dataMode": "fixture-seeded-encrypted-sqlite",
    "mailSendingEnabled": false
  },
  "toolchain": {
    "node": "24.18.0",
    "packageManager": "npm@11.16.0",
    "language": "TypeScript",
    "desktopHost": "Electron",
    "renderer": "React"
  },
  "entrypoints": {
    "main": "src/main/index.ts",
    "preload": "src/preload/index.ts",
    "renderer": "src/renderer/src/main.tsx",
    "application": "src/renderer/src/App.tsx",
    "workspace": "src/renderer/src/features/workspace/Workspace.tsx",
    "mailDataSource": "src/renderer/src/application/mailDataSource.ts",
    "mailRepository": "src/main/application/mailRepository.ts",
    "databaseMigrations": "src/main/infrastructure/sqlite/migrations.ts",
    "secretVaultContract": "src/main/application/secretVault.ts",
    "secretVault": "src/main/infrastructure/sqlite/sqliteSecretVault.ts",
    "credentialProtector": "src/main/infrastructure/security/electronSafeStorageProtector.ts",
    "cacheProtector": "src/main/infrastructure/security/aesGcmCacheProtector.ts",
    "cacheKeyManager": "src/main/infrastructure/security/cacheDataKeyManager.ts",
    "encryptedMailRepository": "src/main/infrastructure/sqlite/encryptedSqliteMailRepository.ts",
    "encryptedCacheMigration": "src/main/infrastructure/sqlite/encryptedCacheMigration.ts",
    "ipcContract": "src/shared/contracts.ts",
    "domainTypes": "src/shared/domain.ts",
    "fixtures": "src/shared/fixtures.ts"
  },
  "scopedInstructions": {
    "renderer": "src/renderer/AGENTS.md",
    "main": "src/main/AGENTS.md",
    "preload": "src/preload/AGENTS.md",
    "shared": "src/shared/AGENTS.md"
  },
  "commands": {
    "install": "npm install",
    "develop": "npm run dev",
    "test": "npm test",
    "typecheck": "npm run typecheck",
    "structureCheck": "npm run check:structure",
    "verify": "npm run verify"
  },
  "continuity": {
    "currentState": "docs/HANDOFF.md",
    "projectHistory": "docs/PROJECT_HISTORY.md",
    "portfolioCaseStudy": "docs/CASE_STUDY.md",
    "updatePolicy": "Material changes update current state; milestones append history; verified portfolio evidence updates the case study."
  },
  "sourcesOfTruth": [
    "AGENTS.md",
    "docs/HANDOFF.md",
    "README.md",
    "docs/MVP.md",
    "docs/ARCHITECTURE.md",
    "docs/DECISIONS.md",
    "docs/DATABASE.md",
    "docs/PRIVACY.md",
    "docs/GMAIL.md",
    "docs/ENGINEERING.md",
    "docs/ENCRYPTED_CACHE.md",
    "docs/PROJECT_HISTORY.md",
    "docs/CASE_STUDY.md",
    "product-spec.md"
  ],
  "invariants": [
    "renderer-has-no-node-or-electron-imports",
    "renderer-never-receives-secrets",
    "mail-account-provenance-remains-visible",
    "generated-claims-retain-source-message-ids",
    "mailbox-mutations-require-explicit-user-approval",
    "external-services-have-deterministic-fake-adapters",
    "fixture-behavior-is-never-presented-as-live",
    "real-mail-ingestion-requires-encrypted-cache",
    "credential-storage-fails-closed-without-os-protection",
    "private-cache-records-use-authenticated-encryption",
    "missing-or-invalid-cache-keys-never-trigger-silent-reset",
    "plaintext-search-indexes-are-forbidden-without-threat-model-review",
    "material-work-maintains-continuity-and-portfolio-evidence"
  ],
  "generatedPaths": [
    "node_modules/",
    "out/",
    "coverage/",
    "*.tsbuildinfo"
  ],
  "verification": {
    "networkRequired": false,
    "credentialsRequired": false,
    "canonicalCommand": "npm run verify"
  }
}
